# 로컬 실행용 예시. 복사해서 .env로 쓰고, .env는 커밋하지 않는다.
DB_URL=jdbc:postgresql://localhost:5432/ticketon
DB_USERNAME=ticketon
DB_PASSWORD=ticketon
# 화면(웹) 기준 주소 — 메일 속 링크(이메일 인증 등)가 이 주소로 시작한다. 운영에서는 반드시 넣는다
WEB_BASE_URL=http://localhost:3000
# 파일(주최자 로고 등) 로컬 저장 위치와 공개 기준 주소(API 서버의 /api/public/files). 업체는 배포 때 정한다. 운영에서 로컬 저장을 쓰면 반드시 넣는다
# 저장 위치를 비워 두면 서버가 뜨지 않는다. 넣지 않으면 개발 기본값(사용자 폴더의 .ticket-on/storage)을 쓴다
# LOCAL_STORAGE_DIRECTORY=/path/to/ticket-on-storage
LOCAL_STORAGE_PUBLIC_BASE_URL=http://localhost:8080/api/public/files
# 관객 카카오·구글 로그인 (카카오 디벨로퍼스·구글 클라우드 콘솔에서 발급). 없으면 그 제공자 로그인만 꺼진다
# 콜백 주소로 {서버 주소}/api/auth/audience/oauth2/callback/kakao · …/callback/google 을 등록한다
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 토스페이먼츠 테스트 키 (개발자센터에서 발급)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
